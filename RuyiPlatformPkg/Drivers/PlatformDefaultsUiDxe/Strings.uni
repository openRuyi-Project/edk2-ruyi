#langdef en-US "English"
#string STR_TITLE #language en-US "Platform Settings"
#string STR_HELP #language en-US "Edit persistent defaults. UEFI variable overrides take priority. Restart to apply."
#string STR_EMULATION #language en-US "UEFI driver emulation"
#string STR_DISABLED #language en-US "Disabled"
#string STR_ENABLED #language en-US "Enabled"
#string STR_EMULATION_HELP #language en-US "Run compatible x64 UEFI drivers and the selected AMD ARM64 GOP. Save changes and restart to apply."
#string STR_PXE_BOOT #language en-US "PXE boot"
#string STR_HTTP_BOOT #language en-US "HTTP boot"
#string STR_PXE_HELP #language en-US "Allow PXE network boot. Save and restart to apply."
#string STR_HTTP_HELP #language en-US "Allow HTTP network boot. Save and restart to apply."

#string STR_DDR_ECC      #language en-US "DDR ECC"
#string STR_DDR_ECC_HELP #language en-US "Enable inline ECC at the next restart. ECC reserves one eighth of DDR capacity for check bits. Disabled by default."
#string STR_CPU_MODE #language en-US "CPU mode"
#string STR_OVERRIDE_PRESENT #language en-US "UEFI overrides are present"
#string STR_CLEAR_OVERRIDES #language en-US "Clear UEFI overrides"
#string STR_OVERRIDE_HELP #language en-US "UEFI variables can override these defaults. Clear the overrides and restart to use the saved defaults."
