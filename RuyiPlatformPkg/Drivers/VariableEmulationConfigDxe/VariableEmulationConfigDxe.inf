[Defines]
  INF_VERSION = 0x0001001B
  BASE_NAME = VariableEmulationConfigDxe
  FILE_GUID = 1afd1f69-f7c8-4ae8-ad10-c4d4c8b2755c
  MODULE_TYPE = DXE_DRIVER
  ENTRY_POINT = VariableEmulationConfigEntry
[Sources]
  Config.c
[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MultiArchUefiPkg/MultiArchUefiPkg.dec
  RuyiPlatformPkg/RuyiPlatformPkg.dec
[LibraryClasses]
  UefiDriverEntryPoint
  DebugLib
  PcdLib
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
[Protocols]
  gRuyiEmulationConfigProtocolGuid
  gEfiVariableArchProtocolGuid
  gEfiVariableWriteArchProtocolGuid
[Pcd]
  gMauPkgTokenSpaceGuid.PcdMauEmulationEnabled
[FixedPcd]
  gRuyiPlatformTokenSpaceGuid.PcdDriverEmulationAvailable
  gRuyiPlatformTokenSpaceGuid.PcdDefaultDriverEmulation
[Depex]
  gEfiVariableArchProtocolGuid AND gEfiVariableWriteArchProtocolGuid
