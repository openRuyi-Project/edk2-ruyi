#include "Forms.h"
formset
  guid = K3_CPU_FORMSET_GUID,
  title = STRING_TOKEN(STR_CPU_TITLE),
  help = STRING_TOKEN(STR_CPU_HELP),
  classguid = gEfiIfrFrontPageGuid,

  varstore K3_CPU_CONFIGURATION,
    varid = 1,
    name = CpuConfig,
    guid = K3_CPU_FORMSET_GUID;

  form formid = 1,
    title = STRING_TOKEN(STR_CPU_TITLE);
    oneof varid = CpuConfig.CpuMode,
      prompt = STRING_TOKEN(STR_CPU_MODE),
      help = STRING_TOKEN(STR_CPU_HELP),
      flags = RESET_REQUIRED,
      option text = STRING_TOKEN(STR_X100_ONLY), value = 0, flags = DEFAULT;
      option text = STRING_TOKEN(STR_MIXED), value = 1, flags = 0;
      option text = STRING_TOKEN(STR_A100_ONLY), value = 2, flags = 0;
    endoneof;
  endform;
endformset;
