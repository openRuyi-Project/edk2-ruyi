#langdef en-US "English"
#string STR_PLATFORM_TITLE #language en-US "Platform Settings"
#string STR_PLATFORM_HELP #language en-US "Configure platform options. Save changes and restart to apply."
#string STR_CPU_MODE #language en-US "CPU mode"
#string STR_X100_ONLY #language en-US "X100 only (8 cores)"
#string STR_MIXED #language en-US "X100 + A100 (16 cores, no vector)"
#string STR_A100_ONLY #language en-US "A100 only (8 cores, vector enabled)"
#string STR_CPU_HELP #language en-US "X100 only retains the original CPU features. Mixed mode disables vector and hypervisor extensions. A100 only enables vectors and has no hypervisor extension. Save and restart to apply. Firmware updates restore X100 only."
#string STR_EMULATION_MODE #language en-US "UEFI driver emulation"
#string STR_DISABLED #language en-US "Disabled"
#string STR_ENABLED #language en-US "Enabled"
#string STR_EMULATION_HELP #language en-US "Run compatible non-native UEFI drivers. Onboard option ROMs use x64 by default; listed AMD GCN graphics devices use the platform ARM64 GOP. Disabled by default. Save and restart to apply."
