[Defines]
  INF_VERSION = 0x0001001B
  BASE_NAME = Sg2042PciDxe
  FILE_GUID = 267d171a-249d-4ca7-adf5-d6c1a25fbbc0
  MODULE_TYPE = DXE_DRIVER
  ENTRY_POINT = Sg2042PciEntry
[Sources]
  Pci.c
  Pioneer.c
  Pioneer.h
  Cadence.h
[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  RuyiPlatformPkg/RuyiPlatformPkg.dec
[LibraryClasses]
  CpuMmioAddressLib
  BaseLib
  DevicePathLib
  FdtI2cReadLib
  FdtHardwareLib
  FdtLib
  IoLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib
[Protocols]
  gRuyiPciControllerProtocolGuid
  gEfiCpuArchProtocolGuid
  gFdtClientProtocolGuid
[Guids]
  gEdkiiPlatformHasDeviceTreeGuid
  gFdtTableGuid
[Depex]
  gEfiCpuArchProtocolGuid AND gFdtClientProtocolGuid AND gEdkiiPlatformHasDeviceTreeGuid
